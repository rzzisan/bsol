{
    "type": "doc",
    "content": [
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "Last updated: August 3, 2026"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "This Privacy Policy explains how Zyrotech BSOL (\"BSOL\", \"we\", \"us\", or \"our\") collects, uses, shares, and protects information when you use our platform — including our sellers (\"merchants\"), their customers who interact with merchant storefronts and landing pages, and anyone who interacts with a merchant's Facebook Page through features we provide. By using BSOL, you agree to the collection and use of information in accordance with this policy."
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 2
            },
            "content": [
                {
                    "type": "text",
                    "text": "1. Information We Collect"
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 3
            },
            "content": [
                {
                    "type": "text",
                    "text": "1.1 Account & Business Information"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "When a seller registers for BSOL, we collect their name, email address, phone number, business\/shop name, and related business details needed to operate their storefront, process orders, and provide billing."
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 3
            },
            "content": [
                {
                    "type": "text",
                    "text": "1.2 Customer & Order Information"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "When an end customer places an order on a merchant's landing page or storefront, we collect the information the customer provides — such as name, phone number, delivery address, and order details — on behalf of the merchant, who is responsible for that customer relationship."
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 3
            },
            "content": [
                {
                    "type": "text",
                    "text": "1.3 Facebook Page Data (Meta Platform)"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "If a seller chooses to connect a Facebook Page to BSOL, we use the Meta Graph API, with the seller's explicit permission, to receive:"
                }
            ]
        },
        {
            "type": "bulletList",
            "content": [
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Comments left on the connected Page's posts"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Messenger conversations sent to the connected Page"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "The Page-scoped name\/ID and message or comment content needed to identify and respond to a potential customer lead"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "We only request the Meta permissions needed for this lead-capture feature (page_show_list, pages_read_engagement, pages_manage_metadata, pages_messaging). We do not access a seller's or their customers' personal Facebook profile, friends list, or any content outside the connected Page's comments and messages. This data is used solely to help the merchant identify and follow up with sales leads inside their BSOL dashboard, and is never sold or used for advertising."
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 3
            },
            "content": [
                {
                    "type": "text",
                    "text": "1.4 Payment & Courier Information"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "To fulfill and deliver orders, limited order and contact details are shared with the courier providers a merchant selects, and payment-related information is processed to complete transactions."
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 3
            },
            "content": [
                {
                    "type": "text",
                    "text": "1.5 Automatically Collected Information"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "Like most web platforms, we automatically collect certain technical information — IP address, browser type, device information, and usage\/log data — through cookies and similar technologies, to keep the service secure and improve performance."
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 2
            },
            "content": [
                {
                    "type": "text",
                    "text": "2. How We Use Information"
                }
            ]
        },
        {
            "type": "bulletList",
            "content": [
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "To create and manage seller accounts and merchant storefronts"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "To process, fulfill, and deliver customer orders"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "To capture and surface Facebook comment\/Messenger leads inside a merchant's dashboard so they can follow up with potential customers"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "To send transactional SMS\/email notifications related to orders, leads, and account activity"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "To provide customer support and respond to inquiries"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "To detect, prevent, and address fraud, abuse, or security issues"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "To comply with legal obligations"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 2
            },
            "content": [
                {
                    "type": "text",
                    "text": "3. How We Share Information"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "We do not sell personal information. We share information only as follows:"
                }
            ]
        },
        {
            "type": "bulletList",
            "content": [
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "With the merchant a customer is interacting with, since BSOL operates the storefront\/lead-capture tools on the merchant's behalf"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "With service providers who help us operate the platform — SMS gateway providers, courier\/delivery partners, and hosting infrastructure — solely to perform the services we ask of them"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "With Meta Platforms, Inc., only to the extent required for the Facebook Page connection feature to function (e.g. exchanging access tokens, receiving webhook events for a Page the seller has connected)"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "When required by law, legal process, or to protect the rights, property, or safety of BSOL, our users, or the public"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 2
            },
            "content": [
                {
                    "type": "text",
                    "text": "4. Facebook\/Meta Platform Data — Additional Commitments"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "In connection with our use of the Meta Graph API and Facebook Login, we additionally commit that:"
                }
            ]
        },
        {
            "type": "bulletList",
            "content": [
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Data received from Facebook Page comments and Messenger messages is used only for the seller's own lead-capture and customer-follow-up purposes within BSOL, never resold or shared with unrelated third parties"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "A seller may disconnect their Facebook Page at any time from their BSOL dashboard, which revokes our access token and stops further data collection from that Page"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "We retain Facebook-sourced lead data only as long as needed for the merchant's lead follow-up, or until the seller deletes it or disconnects the Page"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "We comply with the Meta Platform Terms and Developer Policies applicable to this integration"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 2
            },
            "content": [
                {
                    "type": "text",
                    "text": "5. Data Retention"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "We retain personal information for as long as necessary to provide our services, comply with legal obligations, resolve disputes, and enforce our agreements. Sellers may request deletion of their account and associated data at any time, subject to any records we are legally required to keep."
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 2
            },
            "content": [
                {
                    "type": "text",
                    "text": "6. Data Security"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "We use reasonable administrative, technical, and physical safeguards — including encrypted storage of sensitive credentials such as access tokens — to protect information against unauthorized access, alteration, disclosure, or destruction. No method of transmission or storage is 100% secure, and we cannot guarantee absolute security."
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 2
            },
            "content": [
                {
                    "type": "text",
                    "text": "7. Your Rights & Choices"
                }
            ]
        },
        {
            "type": "bulletList",
            "content": [
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Sellers can access, update, or delete their account information from their BSOL dashboard settings at any time"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Sellers can disconnect a connected Facebook Page at any time, which stops new data collection from that Page"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "End customers may contact the merchant they ordered from, or us directly, to request access to or deletion of their information"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "listItem",
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "You may opt out of non-essential communications at any time"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 2
            },
            "content": [
                {
                    "type": "text",
                    "text": "8. Cookies"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "We use cookies and similar technologies to keep you signed in, remember preferences (such as language), and understand how our platform is used. You can control cookies through your browser settings, though disabling them may affect some features."
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 2
            },
            "content": [
                {
                    "type": "text",
                    "text": "9. Children's Privacy"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "BSOL is not directed to children under 13, and we do not knowingly collect personal information from children under 13. If we learn we have done so, we will delete that information."
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 2
            },
            "content": [
                {
                    "type": "text",
                    "text": "10. Changes to This Policy"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "We may update this Privacy Policy from time to time. Material changes will be reflected by updating the \"Last updated\" date above. Continued use of BSOL after changes take effect constitutes acceptance of the revised policy."
                }
            ]
        },
        {
            "type": "heading",
            "attrs": {
                "level": 2
            },
            "content": [
                {
                    "type": "text",
                    "text": "11. Contact Us"
                }
            ]
        },
        {
            "type": "paragraph",
            "content": [
                {
                    "type": "text",
                    "text": "If you have questions about this Privacy Policy or how your information is handled, contact us at privacy@bsol.zyrotechbd.com."
                }
            ]
        }
    ]
}